{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "protocolVersion", "artifact", "runtime", "capabilities"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "distribution": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["directory", "archive", "package"] },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "publisher": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "email": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": true
        },
        "author": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "email": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": true
        },
        "publishedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "statusCheck": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["url", "jsonrpc", "custom"] },
            "endpoint": { "type": "string" },
            "method": { "enum": ["GET", "HEAD", "POST"] },
            "expectedStatus": { "type": "number" },
            "timeoutMs": { "type": "number" }
          },
          "additionalProperties": true
        },
        "supportsManualReinitialize": { "type": "boolean" },
        "authorSignature": {
          "type": "object",
          "required": ["algorithm", "keyId", "value"],
          "properties": {
            "algorithm": { "enum": ["ed25519", "rsa-sha256"] },
            "keyId": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 },
            "signedAt": { "type": "string" }
          },
          "additionalProperties": true
        },
        "publisherSignature": {
          "type": "object",
          "required": ["algorithm", "keyId", "value"],
          "properties": {
            "algorithm": { "enum": ["ed25519", "rsa-sha256"] },
            "keyId": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 },
            "signedAt": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["entry", "kind"],
      "properties": {
        "kind": {
          "enum": ["source-file", "source-dir", "module", "package", "binary", "shared-library", "wasm"]
        },
        "entry": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": { "type": "string" } }
          ]
        },
        "build": {
          "type": "object",
          "required": ["command"],
          "properties": {
            "command": { "type": "string" },
            "output": { "type": "string" },
            "cwd": { "type": "string" }
          },
          "additionalProperties": true
        },
        "launch": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string" },
            "shell": { "type": "boolean" },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "endpoint": { "type": "string" },
            "transport": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "runtime": { "enum": ["node", "process", "native", "wasm", "remote"] },
    "activationEvents": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "interactionMode": { "enum": ["unary", "server-stream", "client-stream", "duplex", "subscription"] },
          "executionMode": { "enum": ["ephemeral", "session", "persistent"] },
          "realtimeClass": { "enum": ["batch", "interactive", "realtime"] },
          "concurrencyPolicy": { "enum": ["single", "shared", "isolated"] },
          "resourceBudget": {
            "type": "object",
            "properties": {
              "timeoutMs": { "type": "number" },
              "memoryMb": { "type": "number" },
              "maxConcurrency": { "type": "number" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "object",
          "properties": {
            "access": { "type": "string", "minLength": 1 },
            "allow": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "network": {
          "type": "object",
          "properties": {
            "access": { "type": "string", "minLength": 1 },
            "allow": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "process": {
          "type": "object",
          "properties": {
            "access": { "type": "string", "minLength": 1 },
            "allow": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "device": {
          "type": "object",
          "properties": {
            "access": { "type": "string", "minLength": 1 },
            "allow": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
